# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# Where order requests get emailed to, and the key that protects
# GET /api/orders (the admin-only list of submitted requests).
OWNER_EMAIL=oderoevance1003@gmail.com
ADMIN_KEY=change-this-to-a-long-random-value

# Optional — only needed if you want new orders to email you automatically.
# Without these set, orders are still saved to data/orders.json, the
# request just won't trigger an email. For Gmail, use an "app password"
# (Google Account -> Security -> App passwords), not your normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
